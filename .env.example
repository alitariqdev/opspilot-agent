# OpsPilot Configuration Example
# Copy this file to .env and fill in your values

# Operating mode: "demo" or "live"
# - demo: Offline mode, no API calls, deterministic analysis
# - live: Uses OpenAI-compatible API for LLM-powered analysis
OPSPILOT_MODE=demo

# OpenAI API Key (required for live mode, optional for demo)
# Get your key from: https://platform.openai.com/api-keys
# NEVER commit your real API key to version control
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI-compatible Base URL (optional)
# Leave empty for OpenAI, or set for OpenRouter compatibility
# Example for OpenRouter: https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# OpenAI Model (default: gpt-4o-mini)
# For OpenRouter, use format: openai/gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# LLM API Timeout (seconds, default: 60, range: 10-300)
LLM_TIMEOUT_SECONDS=60

# LLM Max Retries (default: 2, range: 0-3)
LLM_MAX_RETRIES=2
